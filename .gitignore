# Local config holds live X-Omni-Secret + LAN key once the app runs — never commit.
# Ship config.toml.example instead; the app writes a real config.toml on first launch.
omni_capture/config.toml
coverage/
omni_capture/.coverage

# testmon test-selection database (tier 0). Rebuildable; never committed.
omni_capture/.testmondata
omni_capture/.testmondata-journal

